# Copy to .env and chmod 600 .env. Never commit your token.
# Discord Developer Portal -> application -> Bot -> Reset Token.
# Enable Message Content Intent and invite the bot (see README).
DISCORD_BOT_TOKEN=

# Discord Settings -> Advanced -> Developer Mode.
# Right-click server icon -> Copy Server ID.
DISCORD_GUILD_ID=
# Right-click parent text channel -> Copy Channel ID (not a thread).
DISCORD_CHANNEL_ID=
# Right-click your profile -> Copy User ID (not the bot).
DISCORD_USER_ID=

# Existing project directory OMP should work in. Must be beneath allowed root.
# This is NOT a filesystem sandbox. Only allow trusted Discord users.
OMP_WORKDIR=~/src/personal/omp-client-bridge
OMP_ALLOWED_ROOT=~/src/personal
OMP_EXECUTABLE=omp
# Leave blank to use your existing OMP default model and authentication.
OMP_MODEL=
