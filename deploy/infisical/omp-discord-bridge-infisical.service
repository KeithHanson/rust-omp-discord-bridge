[Unit]
Description=Fetch OMP Discord Bridge file credentials with Infisical Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Match the selected services-host bridge account.
User=services
Group=services
UMask=0077
RuntimeDirectory=omp-discord-bridge
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=client-id:/etc/omp-discord-bridge/credentials/client-id
LoadCredential=client-secret:/etc/omp-discord-bridge/credentials/client-secret
# Set to discord-token alone in a drop-in when notebook retrieval is disabled.
Environment="BRIDGE_CREDENTIAL_FILES=discord-token notebook-password decision-key"
# Remove previous files before attempting auth; precreate private render targets.
ExecStartPre=/usr/bin/rm -f /run/omp-discord-bridge/discord-token /run/omp-discord-bridge/notebook-password /run/omp-discord-bridge/decision-key
ExecStartPre=/bin/sh -ec 'for f in $$BRIDGE_CREDENTIAL_FILES; do case "$$f" in discord-token|notebook-password|decision-key) ;; *) exit 1;; esac; install -m 0600 /dev/null "/run/omp-discord-bridge/$$f"; done'
ExecStart=/usr/local/bin/infisical agent --config=/etc/omp-discord-bridge/infisical/agent.yaml
ExecStartPost=/bin/sh -ec 'for f in $$BRIDGE_CREDENTIAL_FILES; do chmod 0600 "/run/omp-discord-bridge/$$f"; test -f "/run/omp-discord-bridge/$$f" && test ! -L "/run/omp-discord-bridge/$$f" && test -s "/run/omp-discord-bridge/$$f" || exit 1; done'
# Also runs on failed pre-start, render, validation or timeout. Never keep a partial set.
TimeoutStartSec=120
ExecStopPost=/bin/sh -ec 'if [ "$$SERVICE_RESULT" != success ]; then rm -f /run/omp-discord-bridge/discord-token /run/omp-discord-bridge/notebook-password /run/omp-discord-bridge/decision-key; fi'
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictSUIDSGID=yes
